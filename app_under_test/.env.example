# Copy to .env and adjust. Never commit .env.
APP_CONFIG=development              # development | production
SECRET_KEY=change-me-to-a-long-random-string   # python -c "import secrets; print(secrets.token_hex(32))"
DATABASE_URL=sqlite:///tripmind.db  # relative SQLite path -> instance/tripmind.db
LLM_PROVIDER=local                  # local (Qwen2.5-0.5B from HF cache) | extractive (no LLM)
LLM_TIMEOUT=60                      # seconds before falling back to extractive
RATE_LIMIT=10 per minute            # asks per user / API key
LOGIN_RATE_LIMIT=5 per minute       # login attempts per IP
LOG_LEVEL=INFO
WARMUP_MODELS=true                  # preload models in the background when run.py starts
SAFEGUARDS=off                      # Task 13: on = app/services/safeguards.py wraps every question
SAFE_LLM_TIMEOUT=12                 # Task 13: seconds per LLM attempt when SAFEGUARDS=on (1 retry)
